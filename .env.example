# Copy to .env and adjust. `manage.py` and `docker compose` both read it.

# --- Django ---
# Local development (`manage.py runserver`): true. Anything reachable by others: false.
# Docker Compose ignores this and always runs with debug off.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false; the server refuses to start without it.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Used when DJANGO_DEBUG is false (with it on, every origin is allowed).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:8010
# Both true behind TLS. False only for plain-HTTP local runs.
SECURE_SSL_REDIRECT=false
SECURE_COOKIES=false

# --- Demo ---
# true: requests without an Authorization header act as the seeded subscriber.
# Anyone who can reach the server can then use that account, so it is off by default.
DEMO_AUTH=true
GOOGLE_PAY_SIMULATED=true
# Password of the admin accounts created by `manage.py seed`.
SEED_STAFF_PASSWORD=aicell-demo

# --- Services ---
# The database is a SQLite file: db.sqlite3 here, a volume in Docker.
# Leave REDIS_URL unset for a plain local run (in-memory cache, tasks run inline).
# DATABASE_URL may point at PostgreSQL instead: postgres://user:password@host:5432/name
# REDIS_URL=redis://localhost:63799/0
WEB_PORT=8010
REDIS_PORT=63799

# --- Limits (requests per period; empty switches a limit off) ---
THROTTLE_OTP_IP=5/min
THROTTLE_OTP_PHONE=5/min
THROTTLE_MONEY=30/min
THROTTLE_SUBSCRIBER=300/min
