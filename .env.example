# Copy to .env and adjust. `manage.py` and `docker compose` both read it.

# --- Django ---
# Local development (`manage.py runserver`): true. Anything reachable by others: false.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false; the server refuses to start without it.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Used when DJANGO_DEBUG is false (with it on, every origin is allowed).
CORS_ALLOWED_ORIGINS=
# Both true behind TLS. False only for plain-HTTP local runs.
SECURE_SSL_REDIRECT=false

# --- Services ---
# Leave DATABASE_URL and REDIS_URL unset for a plain local run (SQLite, in-memory cache).
# DATABASE_URL=postgres://aicell:change-me@localhost:54329/aicell
# REDIS_URL=redis://localhost:63799/0
