msgstr "Zənglər üçün"

#: api/tariffs/texts.py
msgid "For internet"
msgstr "İnternet üçün"

#: api/tariffs/texts.py
msgid "Renew tariff"
msgstr "Tarifi yenilə"

#: api/tariffs/texts.py
msgid ""
"The total shows the sum of the internet in your tariff and in all of your "
"active internet packs."
msgstr ""
"Cəm tarifinizdəki və bütün aktiv internet paketlərinizdəki internetin "
"məcmusunu göstərir."

#: api/tariffs/texts.py
msgid ""
"The total shows the sum of the local minutes in your tariff and in all of "
"your active packs."
msgstr ""
"Cəm tarifinizdəki və bütün aktiv paketlərinizdəki ölkədaxili dəqiqələrin "
"məcmusunu göstərir."

#: api/tariffs/texts.py
msgid ""
"To access the Premium theme you must log in with Premium number as main "
"account"
msgstr ""
"Premium mövzusundan istifadə üçün əsas hesab kimi Premium nömrə ilə daxil "
"olmalısınız"

#: api/tariffs/texts.py
msgid ""
"When the subscription fee of the tariff is paid, the line of the number will"
" remain bilaterally active for 28 days."
msgstr ""
"Tarifin abunə haqqı ödənildikdə nömrənin xətti 28 gün ərzində ikitərəfli "
"aktiv qalacaq."

